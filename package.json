{
  "name": "tradient",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && tsc --noEmit && next build",
    "start": "next start --hostname 0.0.0.0",
    "api": "tsx server/api.ts",
    "worker": "tsx server/worker.ts",
    "test": "vitest run",
    "migrate": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@alpacahq/alpaca-trade-api": "5.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.3.7",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "decimal.js": "^10.6.0",
    "fastify": "^5.6.0",
    "lightweight-charts": "^5.0.0",
    "next": "^15.5.0",
    "pg": "^8.23.1",
    "pg-boss": "^10.4.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.20.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prisma": "^7.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
